# Copy this file to .env and fill in your own values. .env is gitignored --
# never commit real credentials, and never paste real values into chat.
#
# Two ways to authenticate with Tiger -- use ONE of them.

# Method 1 (preferred): you exported tiger_openapi_config.properties from
# https://quant.itigerup.com/#developer. Point this at the FOLDER that
# contains that file (not the file itself), e.g.:
#   TIGER_PROPS_PATH=/Users/you/.tigeropen
TIGER_PROPS_PATH=

# Method 2: explicit fields, if you only have the raw PKCS#1 private key
# (.pem) rather than the exported properties file.
TIGER_ID=
TIGER_ACCOUNT=
TIGER_PRIVATE_KEY_PATH=
